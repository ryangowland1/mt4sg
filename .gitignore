# ============================================================================
# Eclipse PDE build artifacts
# ============================================================================
plugins/*/bin/
plugins/*/.gradle/

# Generated EMF, VIATRA, and Xtend code (src-gen, xtend-gen) is committed, so a
# fresh clone builds in Eclipse without running the generators first.

# ============================================================================
# Large CARLA assets (kept locally under carla/, never committed)
# ============================================================================
carla/CARLA_0.9.16/
carla/CARLA_0.9.16.zip
carla/AdditionalMaps_0.9.16.zip
carla/HDMaps/*.pcd

