<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="scenegraph" nsURI="http://mcscert.ca/mt4sg/scenegraph" nsPrefix="ca.mcmaster.mt4sg.models.scenegraph">
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="settingDelegates" value="org.eclipse.viatra.query.querybasedfeature"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="SceneGraph">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodes" upperBound="-1"
        eType="#//Node" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="edges" upperBound="-1"
        eType="#//Edge" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Node" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Edge" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1"
        eType="#//Node"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1"
        eType="#//Node"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="IObjectWithLocation" abstract="true"
      interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="IObjectWithDimensions" abstract="true"
      interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="length" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="width" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SemanticDistanceValue">
    <eLiterals name="PRE_COLLISION" literal="PRE_COLLISION"/>
    <eLiterals name="SUPER_NEAR" value="1" literal="SUPER_NEAR"/>
    <eLiterals name="VERY_NEAR" value="2" literal="VERY_NEAR"/>
    <eLiterals name="NEAR" value="3" literal="NEAR"/>
    <eLiterals name="VISIBLE" value="4" literal="VISIBLE"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SemanticSpatialPositionValue">
    <eLiterals name="LEFT"/>
    <eLiterals name="FRONT_LEFT" value="1" literal="FRONT_LEFT"/>
    <eLiterals name="FRONT" value="2" literal="FRONT"/>
    <eLiterals name="FRONT_RIGHT" value="3" literal="FRONT_RIGHT"/>
    <eLiterals name="RIGHT" value="4" literal="RIGHT"/>
    <eLiterals name="REAR_RIGHT" value="5" literal="REAR_RIGHT"/>
    <eLiterals name="REAR" value="6" literal="REAR"/>
    <eLiterals name="REAR_LEFT" value="7" literal="REAR_LEFT"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Vehicle" eSuperTypes="#//IObjectWithDimensions #//IObjectWithLocation #//IObjectWithSpeed #//Node #//IObjectWithOrientation">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vLongitudinal" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        changeable="false" volatile="true" transient="true" derived="true">
      <eAnnotations source="org.eclipse.viatra.query.querybasedfeature">
        <details key="patternFQN" value="ca.mcmaster.mt4sg.queries.vLongitudinal"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vLateral" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        changeable="false" volatile="true" transient="true" derived="true">
      <eAnnotations source="org.eclipse.viatra.query.querybasedfeature">
        <details key="patternFQN" value="ca.mcmaster.mt4sg.queries.vLateral"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Road" eSuperTypes="#//Node">
    <eStructuralFeatures xsi:type="ecore:EReference" name="lanes" lowerBound="1" upperBound="-1"
        eType="#//Lane" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Lane" eSuperTypes="#//Node">
    <eStructuralFeatures xsi:type="ecore:EReference" name="laneSegments" lowerBound="1"
        upperBound="-1" eType="#//LaneSegment" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LaneSegment" eSuperTypes="#//IObjectWithDimensions #//IObjectWithLocation #//Node #//IObjectWithOrientation"/>
  <eClassifiers xsi:type="ecore:EClass" name="Distance" eSuperTypes="#//Edge">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1" eType="#//SemanticDistanceValue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpatialPosition" eSuperTypes="#//Edge">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1" eType="#//SemanticSpatialPositionValue"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="VehicleInLaneSegment" eSuperTypes="#//Edge"/>
  <eClassifiers xsi:type="ecore:EClass" name="RSSViolation" eSuperTypes="#//Edge"/>
  <eClassifiers xsi:type="ecore:EClass" name="LongitudinalRSSViolation" eSuperTypes="#//RSSViolation"/>
  <eClassifiers xsi:type="ecore:EClass" name="LateralRSSViolation" eSuperTypes="#//RSSViolation"/>
  <eClassifiers xsi:type="ecore:EClass" name="IObjectWithSpeed" abstract="true" interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="speed" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="IObjectWithOrientation" abstract="true"
      interface="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="heading" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
</ecore:EPackage>
