<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.eclipse.ui.externaltools.ProgramLaunchConfigurationType">
    <booleanAttribute key="org.eclipse.debug.core.appendEnvironmentVariables" value="true"/>
    <booleanAttribute key="org.eclipse.debug.ui.ATTR_LAUNCH_IN_BACKGROUND" value="true"/>
    <stringAttribute key="org.eclipse.ui.externaltools.ATTR_LOCATION" value="${env_var:WINDIR}\System32\WindowsPowerShell\v1.0\powershell.exe"/>
    <stringAttribute key="org.eclipse.ui.externaltools.ATTR_TOOL_ARGUMENTS" value="-NoProfile -ExecutionPolicy Bypass -File &quot;${project_loc:ca.mcmaster.mt4sg.models}/../../carla/scripts/run_scenegraph_stream.ps1&quot; -Carla2Ecore &quot;${project_loc:ca.mcmaster.carla2ecore}&quot; -Interval 0.1 -OutDir &quot;${project_loc:ca.mcmaster.mt4sg.models}/../../carla/data/stream&quot;"/>
    <stringAttribute key="org.eclipse.ui.externaltools.ATTR_WORKING_DIRECTORY" value="${project_loc:ca.mcmaster.mt4sg.models}/../../carla"/>
</launchConfiguration>
